<?xml version="1.0"?>
<package format="3">
  <name>panthera_web_hmi</name>
  <version>0.1.0</version>
  <description>Web HMI bridge for Panthera spectrometer workcell using ROS 2 topics and services.</description>
  <maintainer email="153282466@qq.com">tk</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>panthera_interfaces</exec_depend>
  <exec_depend>panthera_motion</exec_depend>
  <exec_depend>panthera_spectrometer_cell</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
